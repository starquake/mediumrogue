    "pixi.js": "^8.22.0",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/howler": "^2.2.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}

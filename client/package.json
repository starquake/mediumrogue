    "pixi.js": "^8.20.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/howler": "^2.2.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
